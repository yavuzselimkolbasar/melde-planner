<?xml version="1.0" encoding="utf-8"?>
<!-- The encrypted secrets (WebUntis password or session, Microsoft refresh token) never
     leave the device: their Keystore key can't be copied, so a copy would be useless. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app.meldeplanner.securestore.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app.meldeplanner.securestore.xml" />
    </device-transfer>
</data-extraction-rules>
