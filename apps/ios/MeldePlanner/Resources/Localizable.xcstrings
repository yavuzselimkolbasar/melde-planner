    "Fächer bündeln Stunden, Meldungen und später deine Noten.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dersler; ders saatlerini, parmak kaldırmaları ve ileride notlarını bir araya getirir."
