    "Fragt kurz nach dem Klingeln „Hast du dich gemeldet?“. Antworte direkt in der Mitteilung. Stunden mit Meldung werden übersprungen.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zil çaldıktan hemen sonra „Parmak kaldırdın mı?“ diye sorar. Doğrudan bildirimden yanıtla. Parmak kaldırdığın dersler atlanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks “Did you raise your hand?” right after the bell. Answer straight from the notification. Lessons you already logged are skipped."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt kurz nach dem Klingeln „Hast du dich gemeldet?“. Antworte direkt in der Mitteilung. Stunden mit Meldung werden übersprungen."
          }
        }
      }
    },
