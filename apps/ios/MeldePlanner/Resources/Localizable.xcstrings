    "Lege deine Fächer und deinen Stundenplan an. Danach ordnet Melde Planner jede Meldung automatisch der laufenden Stunde zu.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Derslerini ve ders programını ekle. Ardından Melde Planner her parmak kaldırmayı otomatik olarak o anki derse atar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your subjects and timetable. Melde Planner then assigns every contribution to the lesson in progress automatically."
          }
        }
      }
    },
    "Lege in den Einstellungen fest, welche Woche eine A-Woche ist. Bis dahin findet die Stunde jede Woche statt.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarda hangi haftanın A haftası olduğunu belirle. O zamana kadar ders her hafta yapılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set which week is week A in Settings. Until then, the lesson takes place every week."
          }
        }
      }
    },
    "Lege zuerst Fächer an, damit Meldungen zugeordnet werden können.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parmak kaldırmaların atanabilmesi için önce ders ekle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add subjects first so contributions can be assigned."
          }
        }
      }
    },
    "Lege zuerst unter „Fächer“ deine Fächer an.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce „Dersler“ bölümünden derslerini ekle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First add your subjects under “Subjects”."
