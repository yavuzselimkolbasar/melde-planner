      }
    },
    "Meldo importiert deinen Stundenplan": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo importiert deinen Stundenplan"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo ders programını aktarır"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo imports your timetable"
          }
        }
      }
    },
    "Meldo zeigt deinen Kurs ab jetzt jede Woche zu dieser Zeit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo zeigt deinen Kurs ab jetzt jede Woche zu dieser Zeit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo bundan sonra her hafta bu saatte senin dersini gösterir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo shows your course at this time every week from now on."
          }
        }
      }
    },
    "Meldo zählt deine Beteiligung und berechnet Durchschnitte. Offizielle Noten vergibt allein deine Schule.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo derse katılımını sayar ve ortalamaları hesaplar. Resmî notları yalnızca okulun verir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo counts your participation and calculates averages. Only your school assigns official grades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo zählt deine Beteiligung und berechnet Durchschnitte. Offizielle Noten vergibt allein deine Schule."
          }
        }
      }
    },
    "Meldo übernimmt deinen Stundenplan, Ausfälle und Vertretungen aus WebUntis. Dein Login bleibt auf diesem iPhone und geht nur an den WebUntis-Server deiner Schule.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo übernimmt deinen Stundenplan, Ausfälle und Vertretungen aus WebUntis. Dein Login bleibt auf diesem iPhone und geht nur an den WebUntis-Server deiner Schule."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo ders programını, iptalleri ve yerine dersleri WebUntis'ten alır. Girişin bu iPhone'da kalır ve yalnızca okulunun WebUntis sunucusuna gider."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo takes your timetable, cancellations and substitutions from WebUntis. Your login stays on this iPhone and only goes to your school's WebUntis server."
          }
        }
      }
    },
    "Meldo übernimmt die Aufgaben deiner Teams-Kurse als Hausaufgaben. Du meldest dich direkt bei Microsoft an; dein Passwort sieht Meldo nie.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo übernimmt die Aufgaben deiner Teams-Kurse als Hausaufgaben. Du meldest dich direkt bei Microsoft an; dein Passwort sieht Meldo nie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo, Teams derslerindeki görevleri ödev olarak alır. Doğrudan Microsoft'ta giriş yaparsın; Meldo şifreni asla görmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo turns the assignments of your Teams classes into homework. You sign in directly at Microsoft; Meldo never sees your password."
          }
        }
      }
    },
