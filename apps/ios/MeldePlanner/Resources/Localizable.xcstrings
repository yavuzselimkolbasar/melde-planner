    "Hi, ich bin Meldo! Lege deine Fächer und deinen Stundenplan an. Danach ordne ich jede Meldung automatisch der laufenden Stunde zu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, ich bin Meldo! Lege deine Fächer und deinen Stundenplan an. Danach ordne ich jede Meldung automatisch der laufenden Stunde zu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merhaba, ben Meldo! Derslerini ve ders programını ekle. Sonra her parmak kaldırmayı otomatik olarak o anki derse atarım."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, I'm Meldo! Add your subjects and timetable. Then I'll assign every contribution to the lesson in progress."
          }
        }
      }
    },
