    "Derselbe Benutzername und dasselbe Passwort wie auf der WebUntis-Seite oder in der Untis-App deiner Schule. Das Passwort wird nur im Schlüsselbund dieses iPhones gespeichert.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derselbe Benutzername und dasselbe Passwort wie auf der WebUntis-Seite oder in der Untis-App deiner Schule. Das Passwort wird nur im Schlüsselbund dieses iPhones gespeichert."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okulunun WebUntis sitesindeki veya Untis uygulamasındaki kullanıcı adı ve şifrenin aynısı. Şifre yalnızca bu iPhone'un anahtar zincirinde saklanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same username and password as on your school's WebUntis page or in the Untis app. The password is stored only in this iPhone's keychain."
