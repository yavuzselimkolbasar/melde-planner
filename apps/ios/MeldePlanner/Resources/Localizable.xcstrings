          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "WebUntis'i bağla, okulunun tatilleri burada görünür. Tatilde Meldo parmak kaldırmayı sormaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect WebUntis and your school's holidays appear here. During holidays Meldo doesn't ask about raising your hand."
          }
        }
