  "strings": {
    "%lld Meldungen pro Woche": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada %lld parmak kaldırma"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld contributions per week"
          }
        }
      }
    },
    "%lld Schultage in Folge": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst üste %lld okul günü"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld school days in a row"
          }
        }
