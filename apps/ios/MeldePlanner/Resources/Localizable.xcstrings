    "Melde Planner zählt deine Beteiligung und berechnet Durchschnitte. Offizielle Noten vergibt allein deine Schule.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde Planner derse katılımını sayar ve ortalamaları hesaplar. Resmî notları yalnızca okulun verir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde Planner counts your participation and calculates averages. Only your school assigns official grades."
