    "Melde dich so an, wie du es von WebUntis kennst, z. B. mit Microsoft 365. Meldo erkennt die Anmeldung automatisch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich so an, wie du es von WebUntis kennst, z. B. mit Microsoft 365. Meldo erkennt die Anmeldung automatisch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "WebUntis'te alıştığın şekilde giriş yap, örneğin Microsoft 365 ile. Meldo girişi otomatik olarak algılar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in the way you know from WebUntis, for example with Microsoft 365. Meldo detects the sign-in automatically."
          }
        }
      }
    },
