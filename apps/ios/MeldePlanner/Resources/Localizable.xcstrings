    "Bisherige Meldungen bleiben erhalten, aber ohne Fach.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut parmak kaldırmalar korunur, ancak derssiz olarak."
