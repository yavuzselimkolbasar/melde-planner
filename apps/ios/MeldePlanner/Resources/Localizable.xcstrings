    "Meldo aktualisiert Ausfälle und Vertretungen automatisch, wenn du die App öffnest (höchstens alle drei Stunden).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo aktualisiert Ausfälle und Vertretungen automatisch, wenn du die App öffnest (höchstens alle drei Stunden)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo, uygulamayı açtığında iptalleri ve yerine dersleri otomatik günceller (en fazla üç saatte bir)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo updates cancellations and substitutions automatically when you open the app (at most every three hours)."
          }
        }
      }
    },
    "Meldo anzeigen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo anzeigen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo'yu göster"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Meldo"
          }
        }
      }
    },
    "Meldo erkennt die Anmeldung noch nicht. Das hat WebUntis geantwortet:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo erkennt die Anmeldung noch nicht. Das hat WebUntis geantwortet:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo girişi henüz algılamıyor. WebUntis'in yanıtı:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo doesn't detect the sign-in yet. This is what WebUntis answered:"
          }
        }
      }
    },
    "Meldo importiert deinen Stundenplan": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo importiert deinen Stundenplan"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo ders programını aktarır"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo imports your timetable"
          }
        }
      }
    },
    "Meldo zählt deine Beteiligung und berechnet Durchschnitte. Offizielle Noten vergibt allein deine Schule.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo derse katılımını sayar ve ortalamaları hesaplar. Resmî notları yalnızca okulun verir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo counts your participation and calculates averages. Only your school assigns official grades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo zählt deine Beteiligung und berechnet Durchschnitte. Offizielle Noten vergibt allein deine Schule."
          }
        }
      }
    },
    "Meldo übernimmt deinen Stundenplan, Ausfälle und Vertretungen aus WebUntis. Dein Login bleibt auf diesem iPhone und geht nur an den WebUntis-Server deiner Schule.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo übernimmt deinen Stundenplan, Ausfälle und Vertretungen aus WebUntis. Dein Login bleibt auf diesem iPhone und geht nur an den WebUntis-Server deiner Schule."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo ders programını, iptalleri ve yerine dersleri WebUntis'ten alır. Girişin bu iPhone'da kalır ve yalnızca okulunun WebUntis sunucusuna gider."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo takes your timetable, cancellations and substitutions from WebUntis. Your login stays on this iPhone and only goes to your school's WebUntis server."
          }
        }
      }
    },
