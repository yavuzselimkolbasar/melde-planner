    "Widgets und der Melden-Knopf brauchen eine App-Gruppe. Installiere Meldo mit AltStore, damit sie deine Daten sehen.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget'lar ve parmak kaldır düğmesi bir uygulama grubuna ihtiyaç duyar. Verilerini görebilmeleri için Meldo'yu AltStore ile yükle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets and the Raise hand button need an App Group. Install Meldo with AltStore so they can see your data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets und der Melden-Knopf brauchen eine App-Gruppe. Installiere Meldo mit AltStore, damit sie deine Daten sehen."
