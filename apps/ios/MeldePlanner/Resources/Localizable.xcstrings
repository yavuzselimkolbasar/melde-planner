    "Gib den Namen deiner Schule zusammen mit dem Ort ein, zum Beispiel „Gymnasium Köln-Pesch“. Bei zu allgemeinen Suchen zeigt WebUntis keine Liste an.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Namen deiner Schule zusammen mit dem Ort ein, zum Beispiel „Gymnasium Köln-Pesch“. Bei zu allgemeinen Suchen zeigt WebUntis keine Liste an."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okulunun adını şehirle birlikte yaz, örneğin „Gymnasium Köln-Pesch“. Çok genel aramalarda WebUntis liste göstermez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your school's name together with the town, for example “Gymnasium Köln-Pesch”. WebUntis shows no list for searches that are too general."
          }
        }
      }
    },
