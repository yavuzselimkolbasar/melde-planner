    "Meldo aktualisiert Stundenplan, Ausfälle und Vertretungen automatisch: beim Öffnen, alle 30 Minuten und im Hintergrund.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo aktualisiert Stundenplan, Ausfälle und Vertretungen automatisch: beim Öffnen, alle 30 Minuten und im Hintergrund."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo ders programını, iptalleri ve vekaletleri otomatik günceller: açılışta, her 30 dakikada ve arka planda."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo updates the timetable, cancellations and substitutions automatically: on opening, every 30 minutes and in the background."
          }
        }
      }
    },
    "Meldo anzeigen": {
      "localizations": {
