{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "indie-apple-stack": {
      "source": { "source": "github", "repo": "rshankras/claude-code-apple-skills" }
    },
    "trailofbits": {
      "source": { "source": "github", "repo": "trailofbits/skills" }
    },
    "thedotmack": {
      "source": { "source": "github", "repo": "thedotmack/claude-mem" }
    },
    "ponytail": {
      "source": { "source": "github", "repo": "DietrichGebert/ponytail" }
    }
  },
  "env": {
    "PONYTAIL_DEFAULT_MODE": "lite"
  },
  "enabledPlugins": {
    "apple-skills@indie-apple-stack": true,
    "ponytail@ponytail": true,
    "claude-mem@thedotmack": true,
    "rust-review@trailofbits": true,
    "property-based-testing@trailofbits": true,
    "insecure-defaults@trailofbits": true,
    "supply-chain-risk-auditor@trailofbits": true,
    "differential-review@trailofbits": true,
    "sharp-edges@trailofbits": true,
    "static-analysis@trailofbits": true,
    "audit-context-building@trailofbits": true,
    "agentic-actions-auditor@trailofbits": true,
    "spec-to-code-compliance@trailofbits": true,
    "fp-check@trailofbits": true,
    "mutation-testing@trailofbits": true,
    "variant-analysis@trailofbits": true
  },
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(graphify query:*)",
      "Bash(graphify path:*)",
      "Bash(graphify explain:*)",
      "Bash(graphify update:*)",
      "Bash(graphify god-nodes:*)",
      "Bash(skillspector scan:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "mcp__basic-memory__search_notes",
      "mcp__basic-memory__read_note",
      "mcp__basic-memory__build_context",
      "mcp__basic-memory__recent_activity"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.p12)",
      "Read(**/*.p8)",
      "Read(**/*.mobileprovision)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
